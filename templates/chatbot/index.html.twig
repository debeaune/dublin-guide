{% extends 'base.html.twig' %}

{% block title %}Dublin Guide{% endblock %}

{% block body %}
<div style="min-height:100vh; background-color:#f9fafb;">

    <div style="background-color:#166534; color:white; padding:48px 16px; text-align:center;">
        <h1 style="font-size:2rem; font-weight:700; margin:0;">🍀 Que cherchez-vous à Dublin ?</h1>
        <p style="margin-top:8px; color:#bbf7d0;">Posez votre question et je vous suggère des lieux</p>
    </div>

    <div style="max-width:700px; margin:0 auto; padding:40px 16px;">
        <form method="GET" action="/chatbot" style="display:flex; gap:8px;">
            <input type="text" name="q" value="{{ question }}"
                placeholder="Ex: randonnée, musée gratuit, bière..."
                style="flex:1; border:1px solid #d1d5db; border-radius:8px; padding:12px 16px; font-size:1rem; color:#1f2937; outline:none;">
            <button type="submit"
                style="background-color:#15803d; color:white; padding:12px 24px; border-radius:8px; border:none; font-size:1rem; cursor:pointer;">
                Chercher
            </button>
        </form>

        {% if question %}
            <div style="margin-top:32px;">
                {% if resultats is empty %}
                    <p style="color:#6b7280; text-align:center;">Aucun lieu trouvé pour "{{ question }}"...</p>
                {% else %}
                    <p style="color:#4b5563; margin-bottom:16px;">{{ resultats|length }} lieu(x) trouvé(s) pour "<strong>{{ question }}</strong>" :</p>
                    <div style="display:flex; flex-direction:column; gap:16px;">
                        {% for lieu in resultats %}
                            <div style="background:white; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,0.1); padding:16px; display:flex; gap:16px; align-items:flex-start;">
                                <img src="/images/lieux/{{ lieu.photo }}"
                                    alt="{{ lieu.nom }}"
                                    style="width:96px; height:96px; object-fit:cover; border-radius:8px; flex-shrink:0;"
                                    onerror="this.style.display='none'">
                                <div>
                                    <span style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#15803d; background-color:#dcfce7; padding:2px 8px; border-radius:9999px;">
                                        {{ lieu.categorie.nom }}
                                    </span>
                                    <h2 style="margin:6px 0 4px; font-size:1.1rem; font-weight:700; color:#111827;">{{ lieu.nom }}</h2>
                                    <p style="font-size:0.875rem; color:#6b7280; margin:0;">{{ lieu.description }}</p>
                                    {% if lieu.anecdote %}
                                    <div style="margin-top:8px; border-left:3px solid #16a34a; padding:4px 10px; background-color:#f0fdf4; border-radius:4px;">
                                        <p style="font-size:0.8rem; color:#15803d; margin:0; font-style:italic;">✨ {{ lieu.anecdote }}</p>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
